# ─────────────────────────────────────────────────────────────────
# .env — API keys and environment configuration
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your keys below
#   3. NEVER commit .env to git (it's in .gitignore)
#
# Alternatively, export these as shell environment variables:
#   export ANTHROPIC_API_KEY="sk-ant-..."
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED: Anthropic Claude API ───────────────────────────────
# Get your key at: console.anthropic.com → API Keys
# Starts with: sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── OPTIONAL: Real-time options data sources ──────────────────────
# Leave blank to use yfinance (free, 15min delay — fine for dev/testing)

# Tradier Developer/Brokerage API (~$10/mo for real-time)
# Get at: tradier.com → Account → API Access → Generate Token
TRADIER_API_KEY=

# Polygon.io Starter plan ($29/mo, best bid/ask data)
# Get at: polygon.io → Dashboard → API Keys
POLYGON_API_KEY=

# ── OPTIONAL: Email alerting (for watchdog) ───────────────────────
# Leave blank to disable email alerts (desktop notifications still work)
ALERT_EMAIL_TO=
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
